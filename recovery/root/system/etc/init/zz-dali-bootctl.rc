import /init.recovery.project.rc

# The official MTK HAL writes UFS boot-region attributes through ufs-bsg0.
# Its node stays system-group readable for tee-supplicant, so give the root
# BootControl service the same supplemental group without changing the node.
service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
    override
    class early_hal
    user root
    group root system
    seclabel u:r:hal_bootctl_default:s0
    interface aidl android.hardware.boot.IBootControl/default
