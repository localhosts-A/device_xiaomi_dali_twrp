import /init.recovery.project.rc

# Official MTK AIDL boot HAL extracted from the stock vendor partition.
# The AIDL binary name is android.hardware.boot-service.mtk (not *_recovery);
# it writes UFS boot-region attributes through libmtk_bsg, which ships in the
# ramdisk /system/lib64 closure. OF_USE_AIDL_BOOT_CONTROL=1 selects this path.
service vendor.boot-default /vendor/bin/hw/android.hardware.boot-service.mtk
    override
    class early_hal
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    seclabel u:r:hal_bootctl_default:s0
    interface aidl android.hardware.boot.IBootControl/default
