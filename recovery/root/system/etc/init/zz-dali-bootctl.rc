# dali uses the HIDL boot HAL (android.hardware.boot@1.0-service) that ships
# with the OrangeFox ramdisk. The MTK AIDL boot HAL (boot-service.mtk_recovery)
# is not present in this device tree, so the AIDL boot-control path is
# disabled (OF_USE_AIDL_BOOT_CONTROL := 0) and init.recovery.project.rc starts
# boot-hal-1-0 instead.
