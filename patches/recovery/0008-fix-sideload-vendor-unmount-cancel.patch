@@ -2175,8 +2179,26 @@ int GUIAction::adbsideloadcancel(std::string arg __unused)
 	kill(sideload_child_pid, SIGTERM);
 	int status;
 	LOGINFO("Waiting for child sideload process to exit.\n");
-	waitpid(sideload_child_pid, &status, 0);
+	bool child_exited = false;
+	for (int attempt = 0; attempt < 5; ++attempt) {
+		const pid_t wait_result = waitpid(sideload_child_pid, &status, WNOHANG);
+		if (wait_result == sideload_child_pid || (wait_result < 0 && errno == ECHILD)) {
+			child_exited = true;
+			break;
+		}
+		if (wait_result < 0) {
+			LOGERR("Unable to wait for child sideload process: %s\n", strerror(errno));
+			break;
+		}
+		::sleep(1);
+	}
+	if (!child_exited) {
+		LOGINFO("Child sideload process did not exit; sending SIGKILL.\n");
+		kill(sideload_child_pid, SIGKILL);
+		waitpid(sideload_child_pid, &status, 0);
+	}
 	sideload_child_pid = 0;
+	TWFunc::Fox_Property_Set("ctl.start", "adbd");
 	DataManager::SetValue("tw_page_done", "1"); // For OpenRecoveryScript support
 	return 0;
 }
