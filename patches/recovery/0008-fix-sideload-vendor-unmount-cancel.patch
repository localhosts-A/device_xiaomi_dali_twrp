 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -2168,6 +2169,9 @@ int GUIAction::adbsideloadcancel(std::string arg __unused)
 	sideload_child_pid = GetMiniAdbdPid();
 	if (!sideload_child_pid) {
 		LOGERR("Unable to get child ID\n");
+		sideload_child_pid = 0;
+		TWFunc::Fox_Property_Set("ctl.start", "adbd");
