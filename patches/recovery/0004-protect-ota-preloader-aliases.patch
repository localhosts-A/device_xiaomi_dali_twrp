+static bool CreateZeroBacking(const char* destination, uint64_t size) {
+    int fd = open(destination, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) {
+        ReportErrno("could not create a boot-chain temporary backing file");
+        return false;
+    }
+    bool result = ftruncate(fd, (off_t)size) == 0 && fsync(fd) == 0;
+    if (!result) {
+        ReportErrno("could not size a boot-chain temporary backing file");
+    }
+    close(fd);
+    if (!result) {
+        unlink(destination);
+    }
+    return result;
+}
