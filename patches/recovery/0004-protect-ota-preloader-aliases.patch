+static bool CreateVirtualAlias(const char* directory, const char* alias, const char* target) {
+    char path[PATH_MAX];
+    if (!BuildPath(path, sizeof(path), directory, alias)) {
+        ReportMessage("could not construct a virtual boot-chain alias path");
+        return false;
+    }
+    struct stat status;
+    if (lstat(path, &status) == 0) {
+        ReportMessage("a real boot-chain alias already exists; refusing to shadow it");
+        return false;
+    }
+    if (errno != ENOENT) {
+        ReportErrno("could not inspect a virtual boot-chain alias");
+        return false;
+    }
+    if (symlink(target, path) != 0) {
+        ReportErrno("could not create a virtual boot-chain alias");
+        return false;
+    }
+    return true;
+}
