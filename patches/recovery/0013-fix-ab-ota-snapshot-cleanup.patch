--- a/twrpinstall/twinstall.cpp
+++ b/twrpinstall/twinstall.cpp
@@ -81,6 +81,34 @@ bool IsLkProtectionSupported() {
 	return strcmp(device, kLkProtectionDevice) == 0;
 }
 
+bool UmountForAbOta(const char* path) {
+	if (umount2(path, 0) == 0) {
+		LOGINFO("Unmounted '%s' for A/B OTA snapshot handling.\n", path);
+		return true;
+	}
+	if (errno == EINVAL || errno == ENOENT) {
+		return true; // not mounted
+	}
+	LOGERR("Unable to unmount '%s' for A/B OTA snapshot handling: %s\n", path, strerror(errno));
+	return false;
+}
+
+void DeleteDmDevice(const char* name) {
+    const char* const argv[] = {"/system/bin/dmctl", "delete", name, nullptr};
+    const pid_t pid = fork();
+    if (pid == 0) {
+        execv(argv[0], const_cast<char**>(argv));
+        _exit(127);
+    }
+    if (pid > 0) {
+        int status = 0;
+        waitpid(pid, &status, 0);
+        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
+            LOGINFO("Removed stale A/B snapshot device '%s'.\n", name);
+        }
+    }
+}
+
 } // namespace
 
 enum zip_type {
