+			UmountForAbOta("/system_ext");
+			UmountForAbOta("/vendor_dlkm");
+			UmountForAbOta("/odm_dlkm");
+			UmountForAbOta("/system_dlkm");
+
+			LOGINFO("Clearing stale A/B snapshot devices.\n");
