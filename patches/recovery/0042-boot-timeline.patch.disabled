+// ---- temporary boot timeline instrumentation (remove after tuning) ----
+static void bootmark(const char* stage) {
+    struct timespec bt;
+    clock_gettime(CLOCK_BOOTTIME, &bt);
+    FILE* f = fopen("/tmp/boot-timeline", "a");
+    if (f) {
+        fprintf(f, "twrp: stage=%s up=%lld.%03ld\n", stage, (long long)bt.tv_sec, bt.tv_nsec / 1000000);
+        fclose(f);
+    }
+}
+// ---- end instrumentation ----
+
