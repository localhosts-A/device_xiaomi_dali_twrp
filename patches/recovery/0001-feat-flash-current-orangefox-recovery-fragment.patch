+static bool ReadVendorBootAvb(const std::string& image, uint64_t expected_size, VendorBootAvbInfo* info) {
+	struct stat st {};
+	if (stat(image.c_str(), &st) != 0 || st.st_size < static_cast<off_t>(AVB_FOOTER_SIZE) ||
+		static_cast<uint64_t>(st.st_size) != expected_size)
+		return false;
+
+	int fd = open(image.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	AvbFooter raw_footer{};
+	bool result = ReadFullyAt(fd, &raw_footer, sizeof(raw_footer), expected_size - AVB_FOOTER_SIZE);
+	close(fd);
+	if (!result || !avb_footer_validate_and_byteswap(&raw_footer, &info->footer))
+		return false;
+
+	if (info->footer.original_image_size == 0 ||
+		info->footer.original_image_size > info->footer.vbmeta_offset ||
+		info->footer.vbmeta_offset > expected_size - AVB_FOOTER_SIZE ||
+		info->footer.vbmeta_size > expected_size - AVB_FOOTER_SIZE - info->footer.vbmeta_offset ||
+		info->footer.vbmeta_size > std::numeric_limits<size_t>::max())
+		return false;
+
+	if (info->footer.vbmeta_size < AVB_VBMETA_IMAGE_HEADER_SIZE)
+		return false;
+
+	info->vbmeta.resize(static_cast<size_t>(info->footer.vbmeta_size));
+	fd = open(image.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	result = ReadFullyAt(fd, info->vbmeta.data(), info->vbmeta.size(), info->footer.vbmeta_offset);
+	close(fd);
+	if (!result)
+		return false;
+	const AvbVBMetaVerifyResult verify_result =
+		avb_vbmeta_image_verify(info->vbmeta.data(), info->vbmeta.size(), nullptr, nullptr);
+	if (verify_result != AVB_VBMETA_VERIFY_RESULT_OK_NOT_SIGNED) {
+		LOGERR("Vendor_boot AVB must use Algorithm NONE for fragment reflash (got %s)\n",
+			avb_vbmeta_verify_result_to_string(verify_result));
+		return false;
+	}
+
+	AvbVBMetaImageHeader header{};
+	avb_vbmeta_image_header_to_host_byte_order(
+		reinterpret_cast<const AvbVBMetaImageHeader*>(info->vbmeta.data()), &header);
+	if (header.algorithm_type != AVB_ALGORITHM_TYPE_NONE ||
+		header.authentication_data_block_size > info->vbmeta.size() - AVB_VBMETA_IMAGE_HEADER_SIZE ||
+		header.auxiliary_data_block_size > info->vbmeta.size() - AVB_VBMETA_IMAGE_HEADER_SIZE - header.authentication_data_block_size ||
+		header.descriptors_offset > header.auxiliary_data_block_size ||
+		header.descriptors_size > header.auxiliary_data_block_size - header.descriptors_offset)
+		return false;
+
+	const size_t auxiliary_start = AVB_VBMETA_IMAGE_HEADER_SIZE +
+		static_cast<size_t>(header.authentication_data_block_size);
+	if (header.descriptors_offset > info->vbmeta.size() - auxiliary_start)
+		return false;
+	const size_t descriptors_start = auxiliary_start + static_cast<size_t>(header.descriptors_offset);
+	if (header.descriptors_size > info->vbmeta.size() - descriptors_start)
+		return false;
+
+	size_t cursor = descriptors_start;
+	const size_t end = cursor + static_cast<size_t>(header.descriptors_size);
+	int matches = 0;
+	while (cursor < end) {
+		if (end - cursor < sizeof(AvbDescriptor))
+			return false;
+
+		const auto* raw_descriptor = reinterpret_cast<const AvbDescriptor*>(info->vbmeta.data() + cursor);
+		AvbDescriptor descriptor{};
+		if (!avb_descriptor_validate_and_byteswap(raw_descriptor, &descriptor) ||
+			descriptor.num_bytes_following > end - cursor - sizeof(AvbDescriptor))
+			return false;
+
+		const size_t descriptor_size = sizeof(AvbDescriptor) + static_cast<size_t>(descriptor.num_bytes_following);
+		if (descriptor.tag == AVB_DESCRIPTOR_TAG_HASH) {
+			if (descriptor_size < sizeof(AvbHashDescriptor))
+				return false;
+
+			const auto* raw_hash = reinterpret_cast<const AvbHashDescriptor*>(raw_descriptor);
+			AvbHashDescriptor hash{};
+			if (!avb_hash_descriptor_validate_and_byteswap(raw_hash, &hash))
+				return false;
+
+			const uint64_t variable_size = static_cast<uint64_t>(hash.partition_name_len) + hash.salt_len + hash.digest_len;
+			if (variable_size > descriptor_size - sizeof(AvbHashDescriptor))
+				return false;
+
+			const uint8_t* partition_name = info->vbmeta.data() + cursor + sizeof(AvbHashDescriptor);
+			if (hash.partition_name_len == sizeof(kVendorBootPartitionName) - 1 &&
+				std::memcmp(partition_name, kVendorBootPartitionName, sizeof(kVendorBootPartitionName) - 1) == 0) {
+				const bool canonical_sha256 = std::memcmp(hash.hash_algorithm, "sha256", 6) == 0 &&
+					std::all_of(hash.hash_algorithm + 6, hash.hash_algorithm + sizeof(hash.hash_algorithm),
+						[](uint8_t value) { return value == 0; });
+				if (!canonical_sha256 || hash.digest_len != SHA256_DIGEST_LENGTH || ++matches != 1)
+					return false;
+				info->descriptor_offset = cursor;
+				info->salt_offset = cursor + sizeof(AvbHashDescriptor) + hash.partition_name_len;
+				info->salt_size = hash.salt_len;
+				info->digest_offset = info->salt_offset + hash.salt_len;
+				info->digest_size = hash.digest_len;
+				info->descriptor_image_size = hash.image_size;
+			}
+		}
+
+		cursor += descriptor_size;
+	}
+	return cursor == end && matches == 1;
+}
