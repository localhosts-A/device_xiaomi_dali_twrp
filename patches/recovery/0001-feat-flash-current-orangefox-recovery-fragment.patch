+static bool CalculateVendorBootDigest(const std::string& image, const VendorBootAvbInfo& info,
+		std::array<uint8_t, SHA256_DIGEST_LENGTH>* digest) {
+	int fd = open(image.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	SHA256_CTX context{};
+	bool result = SHA256_Init(&context) == 1 &&
+		SHA256_Update(&context, info.vbmeta.data() + info.salt_offset, info.salt_size) == 1;
+	std::array<uint8_t, kHashChunkSize> buffer{};
+	uint64_t offset = 0;
+	while (result && offset < info.footer.original_image_size) {
+		size_t to_read = static_cast<size_t>(std::min<uint64_t>(buffer.size(), info.footer.original_image_size - offset));
+		result = ReadFullyAt(fd, buffer.data(), to_read, offset) && SHA256_Update(&context, buffer.data(), to_read) == 1;
+		offset += to_read;
+	}
+	if (result)
+		result = SHA256_Final(digest->data(), &context) == 1;
+	close(fd);
+	return result;
+}
+
+static bool VerifyVendorBootAvb(const std::string& image, uint64_t expected_size) {
+	VendorBootAvbInfo info;
+	std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+	return ReadVendorBootAvb(image, expected_size, &info) &&
+		info.descriptor_image_size == info.footer.original_image_size &&
+		CalculateVendorBootDigest(image, info, &digest) &&
+		std::memcmp(digest.data(), info.vbmeta.data() + info.digest_offset, digest.size()) == 0;
+}
+
+static bool RepairVendorBootAvb(const std::string& image, uint64_t expected_size) {
+	VendorBootAvbInfo info;
+	std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+	if (!ReadVendorBootAvb(image, expected_size, &info) || !CalculateVendorBootDigest(image, info, &digest))
+		return false;
+
+	const uint64_t serialized_size = avb_htobe64(info.footer.original_image_size);
+	std::memcpy(info.vbmeta.data() + info.descriptor_offset + offsetof(AvbHashDescriptor, image_size),
+		&serialized_size, sizeof(serialized_size));
+	std::memcpy(info.vbmeta.data() + info.digest_offset, digest.data(), digest.size());
+
+	int fd = open(image.c_str(), O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	bool result = WriteFullyAt(fd, info.vbmeta.data(), info.vbmeta.size(), info.footer.vbmeta_offset) && fsync(fd) == 0;
+	close(fd);
+	return result && VerifyVendorBootAvb(image, expected_size);
+}
