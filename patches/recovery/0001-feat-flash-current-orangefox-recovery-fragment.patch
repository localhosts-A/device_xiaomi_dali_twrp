+static bool ReadFullyAt(int fd, void* buffer, size_t size, uint64_t offset) {
+	if (offset > static_cast<uint64_t>(std::numeric_limits<off_t>::max()) ||
+		size > static_cast<uint64_t>(std::numeric_limits<off_t>::max()) - offset)
+		return false;
+
+	uint8_t* cursor = static_cast<uint8_t*>(buffer);
+	size_t done = 0;
+	while (done < size) {
+		ssize_t read_size = pread(fd, cursor + done, size - done, static_cast<off_t>(offset + done));
+		if (read_size < 0) {
+			if (errno == EINTR)
+				continue;
+			return false;
+		}
+		if (read_size == 0)
+			return false;
+		done += static_cast<size_t>(read_size);
+	}
+	return true;
+}
+
+static bool WriteFullyAt(int fd, const void* buffer, size_t size, uint64_t offset) {
+	if (offset > static_cast<uint64_t>(std::numeric_limits<off_t>::max()) ||
+		size > static_cast<uint64_t>(std::numeric_limits<off_t>::max()) - offset)
+		return false;
+
+	const uint8_t* cursor = static_cast<const uint8_t*>(buffer);
+	size_t done = 0;
+	while (done < size) {
+		ssize_t write_size = pwrite(fd, cursor + done, size - done, static_cast<off_t>(offset + done));
+		if (write_size < 0) {
+			if (errno == EINTR)
+				continue;
+			return false;
+		}
+		if (write_size == 0)
+			return false;
+		done += static_cast<size_t>(write_size);
+	}
+	return true;
+}
