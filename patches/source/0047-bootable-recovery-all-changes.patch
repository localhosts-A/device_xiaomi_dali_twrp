+					snprintf(ab_device_name, sizeof(ab_device_name), "%s%s-cow-img", partition, slot);
+					DeleteDmDevice(ab_device_name);
+				}
+			}
+
+			} else {
+				LOGERR("Some A/B super mounts could not be unmounted; skipping stale snapshot device cleanup to avoid deleting in-use devices.\n");
+			}
+
+			if (PartitionManager.Mount_By_Path("/metadata", false)) {
+				LOGINFO("Mounted /metadata for A/B OTA snapshot handling.\n");
+			} else {
+				LOGERR("Unable to mount /metadata for A/B OTA snapshot handling.\n");
+			}
+			// NOTE: do NOT delete /metadata/ota/snapshots status files here.
+			// update_engine reads them when deciding whether to keep or wipe
+			// the snapshots; deleting them makes it schedule a wipe and drop
+			// /metadata/ota, after which FinishMergeInRecovery has nothing to
+			// merge (observed: "Open failed: /metadata/ota: No such file or
+			// directory" + "FinishMergeInRecovery failed" on dali downgrade).
+			LOGINFO("DEBUG: after metadata mount, calling Run_Update_Binary.\n");
 			ret_val = Run_Update_Binary(path, wipe_cache, AB_OTA_ZIP_TYPE);
+			LOGINFO("DEBUG: Run_Update_Binary returned %d.\n", ret_val);
 
 			DataManager::SetValue(FOX_ZIP_INSTALLER_CODE, 1); // mark as custom ROM install
 
