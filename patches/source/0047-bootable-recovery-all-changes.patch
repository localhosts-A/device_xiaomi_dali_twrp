+static bool CalculateVendorBootDigest(const std::string& image, const VendorBootAvbInfo& info,
+		std::array<uint8_t, SHA256_DIGEST_LENGTH>* digest) {
+	int fd = open(image.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	SHA256_CTX context{};
+	bool result = SHA256_Init(&context) == 1 &&
+		SHA256_Update(&context, info.vbmeta.data() + info.salt_offset, info.salt_size) == 1;
+	std::array<uint8_t, kHashChunkSize> buffer{};
+	uint64_t offset = 0;
+	while (result && offset < info.footer.original_image_size) {
+		size_t to_read = static_cast<size_t>(std::min<uint64_t>(buffer.size(), info.footer.original_image_size - offset));
+		result = ReadFullyAt(fd, buffer.data(), to_read, offset) && SHA256_Update(&context, buffer.data(), to_read) == 1;
+		offset += to_read;
+	}
+	if (result)
+		result = SHA256_Final(digest->data(), &context) == 1;
+	close(fd);
+	return result;
+}
+
+static bool VerifyVendorBootAvb(const std::string& image, uint64_t expected_size) {
+	VendorBootAvbInfo info;
+	std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+	return ReadVendorBootAvb(image, expected_size, &info) &&
+		info.descriptor_image_size == info.footer.original_image_size &&
+		CalculateVendorBootDigest(image, info, &digest) &&
+		std::memcmp(digest.data(), info.vbmeta.data() + info.digest_offset, digest.size()) == 0;
+}
+
+static bool RepairVendorBootAvb(const std::string& image, uint64_t expected_size) {
+	VendorBootAvbInfo info;
+	std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+	if (!ReadVendorBootAvb(image, expected_size, &info) || !CalculateVendorBootDigest(image, info, &digest))
+		return false;
+
+	const uint64_t serialized_size = avb_htobe64(info.footer.original_image_size);
+	std::memcpy(info.vbmeta.data() + info.descriptor_offset + offsetof(AvbHashDescriptor, image_size),
+		&serialized_size, sizeof(serialized_size));
+	std::memcpy(info.vbmeta.data() + info.digest_offset, digest.data(), digest.size());
+
+	int fd = open(image.c_str(), O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	bool result = WriteFullyAt(fd, info.vbmeta.data(), info.vbmeta.size(), info.footer.vbmeta_offset) && fsync(fd) == 0;
+	close(fd);
+	return result && VerifyVendorBootAvb(image, expected_size);
+}
+
+static std::string ShellQuote(const std::string& value) {
+	std::string quoted("'");
+	for (char character : value) {
+		if (character == '\'')
+			quoted += "'\\''";
+		else
+			quoted += character;
+	}
+	return quoted + "'";
+}
+
+static bool CompareFiles(const std::string& first, const std::string& second) {
+	return TWFunc::Exec_Cmd("/system/bin/cmp -s " + ShellQuote(first) + " " + ShellQuote(second), false) == 0;
+}
+
+static bool CompareOptionalFile(const std::string& first, const std::string& second) {
+	const bool first_exists = TWFunc::Path_Exists(first);
+	return first_exists == TWFunc::Path_Exists(second) && (!first_exists || CompareFiles(first, second));
+}
+
+static bool ListVendorRamdisks(const std::string& directory, std::vector<std::string>* files) {
+	DIR* handle = opendir(directory.c_str());
+	if (!handle)
+		return false;
+
+	files->clear();
+	while (dirent* entry = readdir(handle)) {
+		const std::string name(entry->d_name);
+		if (name.size() >= 20 && name.compare(0, 15, "vendor_ramdisk_") == 0 &&
+			name.compare(name.size() - 5, 5, ".cpio") == 0)
+			files->push_back(name);
+	}
+	closedir(handle);
+	std::sort(files->begin(), files->end());
+	return !files->empty();
+}
+
+static bool CompareRetainedVendorRamdisks(const std::string& original, const std::string& rebuilt) {
+	std::vector<std::string> original_files;
+	std::vector<std::string> rebuilt_files;
+	if (!ListVendorRamdisks(original, &original_files) || !ListVendorRamdisks(rebuilt, &rebuilt_files) ||
+		original_files != rebuilt_files)
+		return false;
+
+	for (const std::string& name : original_files) {
+		if (name != "vendor_ramdisk_recovery.cpio" && !CompareFiles(original + "/" + name, rebuilt + "/" + name))
+			return false;
+	}
+	return true;
+}
+
+constexpr char kVendorBootMagic[] = "VNDRBOOT";
+constexpr size_t kVendorBootHeaderPrefixSize = 28;
+constexpr size_t kVendorBootHeaderVersionOffset = 8;
+constexpr size_t kVendorBootPageSizeOffset = 12;
+constexpr size_t kVendorBootRamdiskSizeOffset = 24;
+
+struct VendorBootRamdiskLayout {
+	uint32_t page_size = 0;
+	uint64_t payload_size = 0;
+};
+
+enum class CpioEntryKind {
+	kDirectory,
+	kFile,
+	kSymlink,
+};
+
+using CpioEntries = std::map<std::string, CpioEntryKind>;
+
+static bool GetRegularFileSize(const std::string& path, uint64_t* size) {
+	struct stat st {};
+	if (stat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 0)
+		return false;
+	*size = static_cast<uint64_t>(st.st_size);
+	return true;
+}
+
+static uint32_t ReadLittleEndian32(const uint8_t* value) {
+	return static_cast<uint32_t>(value[0]) |
+		(static_cast<uint32_t>(value[1]) << 8) |
+		(static_cast<uint32_t>(value[2]) << 16) |
+		(static_cast<uint32_t>(value[3]) << 24);
+}
+
+static bool IsPowerOfTwo(uint32_t value) {
+	return value != 0 && (value & (value - 1)) == 0;
+}
+
+static bool AlignUp(uint64_t value, uint32_t alignment, uint64_t* aligned) {
+	if (!IsPowerOfTwo(alignment))
+		return false;
+	const uint64_t padding = (static_cast<uint64_t>(alignment) - (value & (alignment - 1))) & (alignment - 1);
+	if (value > std::numeric_limits<uint64_t>::max() - padding)
+		return false;
+	*aligned = value + padding;
+	return true;
+}
+
+static bool ReadVendorBootRamdiskLayout(const std::string& image, const std::string& directory,
+		VendorBootRamdiskLayout* layout) {
+	std::array<uint8_t, kVendorBootHeaderPrefixSize> header{};
+	int fd = open(image.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	const bool read_ok = ReadFullyAt(fd, header.data(), header.size(), 0);
+	close(fd);
+	if (!read_ok || std::memcmp(header.data(), kVendorBootMagic, sizeof(kVendorBootMagic) - 1) != 0 ||
+		ReadLittleEndian32(header.data() + kVendorBootHeaderVersionOffset) != 4)
+		return false;
+
+	const uint32_t page_size = ReadLittleEndian32(header.data() + kVendorBootPageSizeOffset);
+	if (page_size < 2048 || page_size > 16384 || !IsPowerOfTwo(page_size))
+		return false;
+	const uint64_t declared_size = ReadLittleEndian32(header.data() + kVendorBootRamdiskSizeOffset);
+
+	std::vector<std::string> ramdisks;
+	if (!ListVendorRamdisks(directory, &ramdisks))
+		return false;
+	uint64_t measured_size = 0;
+	for (const std::string& name : ramdisks) {
+		uint64_t size = 0;
+		if (!GetRegularFileSize(directory + "/" + name, &size) ||
+			size > std::numeric_limits<uint64_t>::max() - measured_size)
+			return false;
+		measured_size += size;
+	}
+	if (measured_size != declared_size)
+		return false;
+
+	layout->page_size = page_size;
+	layout->payload_size = measured_size;
+	return true;
+}
+
+static bool CanDirectlyReplaceRecoveryFragment(const VendorBootAvbInfo& avb, const std::string& image,
+		const std::string& directory, const std::string& inactive_recovery, const std::string& source_recovery,
+		bool* fits) {
+	VendorBootRamdiskLayout layout;
+	uint64_t inactive_recovery_size = 0;
+	uint64_t source_recovery_size = 0;
+	if (!ReadVendorBootRamdiskLayout(image, directory, &layout) ||
+		!GetRegularFileSize(inactive_recovery, &inactive_recovery_size) ||
+		!GetRegularFileSize(source_recovery, &source_recovery_size) ||
+		layout.payload_size < inactive_recovery_size)
+		return false;
+
+	uint64_t replacement_payload_size = layout.payload_size - inactive_recovery_size;
+	if (source_recovery_size > std::numeric_limits<uint64_t>::max() - replacement_payload_size)
+		return false;
+	replacement_payload_size += source_recovery_size;
+
+	uint64_t original_padded_size = 0;
+	uint64_t replacement_padded_size = 0;
+	if (!AlignUp(layout.payload_size, layout.page_size, &original_padded_size) ||
+		!AlignUp(replacement_payload_size, layout.page_size, &replacement_padded_size))
+		return false;
+
+	uint64_t predicted_preavb_size = avb.footer.original_image_size;
+	if (replacement_padded_size >= original_padded_size) {
+		const uint64_t growth = replacement_padded_size - original_padded_size;
+		if (growth > std::numeric_limits<uint64_t>::max() - predicted_preavb_size)
+			return false;
+		predicted_preavb_size += growth;
+	} else {
+		const uint64_t shrink = original_padded_size - replacement_padded_size;
+		if (shrink > predicted_preavb_size)
+			return false;
+		predicted_preavb_size -= shrink;
+	}
+
+	*fits = predicted_preavb_size <= avb.footer.vbmeta_offset;
+	return true;
+}
+
+static bool IsSafeCpioPath(const std::string& path) {
+	if (path.empty() || path.front() == '/' || path.back() == '/')
+		return false;
+	for (size_t start = 0; start < path.size();) {
+		const size_t slash = path.find('/', start);
+		const size_t end = slash == std::string::npos ? path.size() : slash;
+		if (end == start)
+			return false;
+		const std::string component = path.substr(start, end - start);
+		if (component == "." || component == "..")
+			return false;
+		for (char character : component) {
+			const bool allowed = (character >= 'a' && character <= 'z') ||
+				(character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') ||
+				character == '.' || character == '_' || character == '-' || character == '+' ||
+				character == '=' || character == '@' || character == '[' || character == ']';
+			if (!allowed)
+				return false;
+		}
+		if (slash == std::string::npos)
+			break;
+		start = slash + 1;
+	}
+	return true;
+}
+
+static bool ParseCpioEntries(const std::string& listing, CpioEntries* entries) {
+	entries->clear();
+	for (size_t start = 0; start < listing.size();) {
+		const size_t newline = listing.find('\n', start);
+		std::string line = listing.substr(start, newline == std::string::npos ? std::string::npos : newline - start);
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+		if (!line.empty()) {
+			const size_t first_tab = line.find('\t');
+			const size_t last_tab = line.rfind('\t');
+			if (first_tab == std::string::npos || last_tab == std::string::npos || first_tab == 0 || last_tab + 1 >= line.size())
+				return false;
+			CpioEntryKind kind;
+			switch (line.front()) {
+			case 'd': kind = CpioEntryKind::kDirectory; break;
+			case '-': kind = CpioEntryKind::kFile; break;
+			case 'l': kind = CpioEntryKind::kSymlink; break;
+			default: return false;
+			}
+			const std::string path = line.substr(last_tab + 1);
+			if (!IsSafeCpioPath(path) || !entries->emplace(path, kind).second)
+				return false;
+		}
+		if (newline == std::string::npos)
+			break;
+		start = newline + 1;
+	}
+	return !entries->empty();
+}
+
+static bool ListCpioEntries(const std::string& magiskboot, const std::string& cpio, CpioEntries* entries) {
+	std::string listing;
+	if (TWFunc::Exec_Cmd(ShellQuote(magiskboot) + " cpio " + ShellQuote(cpio) + " " +
+			ShellQuote("ls -r /"), listing) != 0)
+		return false;
+	return ParseCpioEntries(listing, entries);
+}
+
+static bool HasNonDirectoryAncestor(const CpioEntries& entries, const std::string& path) {
+	for (size_t slash = path.find('/'); slash != std::string::npos; slash = path.find('/', slash + 1)) {
+		const auto found = entries.find(path.substr(0, slash));
+		if (found != entries.end() && found->second != CpioEntryKind::kDirectory)
+			return true;
+	}
+	return false;
+}
+
+static bool VerifyCpioOverlay(const CpioEntries& platform, const CpioEntries& recovery) {
+	for (const auto& recovery_entry : recovery) {
+		const std::string& path = recovery_entry.first;
+		if (HasNonDirectoryAncestor(platform, path))
+			return false;
+		const auto platform_entry = platform.find(path);
+		if (recovery_entry.second == CpioEntryKind::kDirectory) {
+			if (platform_entry != platform.end() && platform_entry->second != CpioEntryKind::kDirectory)
+				return false;
+		} else if (platform_entry != platform.end()) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool TrimPlatformFragment(const std::string& magiskboot, const std::string& platform_cpio,
+		const std::string& recovery_cpio) {
+	CpioEntries platform_entries;
+	CpioEntries recovery_entries;
+	if (!ListCpioEntries(magiskboot, platform_cpio, &platform_entries) ||
+		!ListCpioEntries(magiskboot, recovery_cpio, &recovery_entries))
+		return false;
+
+	std::vector<std::string> removals;
+	for (const auto& recovery_entry : recovery_entries) {
+		const std::string& path = recovery_entry.first;
+		if (HasNonDirectoryAncestor(platform_entries, path)) {
+			LOGERR("Unsafe platform CPIO ancestor for Recovery path '%s'\n", path.c_str());
+			return false;
+		}
+		const auto platform_entry = platform_entries.find(path);
+		if (platform_entry == platform_entries.end())
+			continue;
+		if (recovery_entry.second == CpioEntryKind::kDirectory) {
+			if (platform_entry->second != CpioEntryKind::kDirectory) {
+				LOGERR("Unsafe platform CPIO type conflict at '%s'\n", path.c_str());
+				return false;
+			}
+			continue;
+		}
+		removals.push_back((platform_entry->second == CpioEntryKind::kDirectory ? "rm -r " : "rm ") + path);
+	}
+
+	std::string command = ShellQuote(magiskboot) + " cpio " + ShellQuote(platform_cpio);
+	for (const std::string& removal : removals) {
+		if (command.size() > 65536 - removal.size() - 3) {
+			LOGERR("Too many platform CPIO entries to trim safely\n");
+			return false;
+		}
+		command += " " + ShellQuote(removal);
+	}
+	if (!removals.empty() && TWFunc::Exec_Cmd(command, false) != 0)
+		return false;
+
+	CpioEntries trimmed_entries;
+	return ListCpioEntries(magiskboot, platform_cpio, &trimmed_entries) &&
+		VerifyCpioOverlay(trimmed_entries, recovery_entries);
+}
+
+static bool IsUncompressedCpio(const std::string& path) {
+	std::array<char, 6> magic{};
+	int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	const bool read_ok = ReadFullyAt(fd, magic.data(), magic.size(), 0);
+	close(fd);
+	return read_ok && (std::memcmp(magic.data(), "070701", magic.size()) == 0 ||
+		std::memcmp(magic.data(), "070702", magic.size()) == 0);
+}
+
+static bool MakeUncompressedCpio(const std::string& magiskboot, const std::string& input, const std::string& output) {
+	if (IsUncompressedCpio(input))
+		return TWFunc::copy_file(input, output, 0644, false) == 0;
+	return TWFunc::Exec_Cmd(ShellQuote(magiskboot) + " decompress " + ShellQuote(input) + " " +
+		ShellQuote(output), false) == 0 && IsUncompressedCpio(output);
+}
+
+static bool FlashCurrentVendorBootRecoveryFragment(TWPartition* target_partition, const std::string& slot) {
+	if (!target_partition || !TWFunc::Path_Exists(TWFunc::Get_MagiskBoot())) {
+		LOGERR("Vendor_boot fragment reflash prerequisites are unavailable\n");
+		return false;
+	}
+
+	std::string active_suffix;
+	std::string inactive_suffix;
+	if (slot == "_a" || slot == "a") {
+		active_suffix = "_a";
+		inactive_suffix = "_b";
+	} else if (slot == "_b" || slot == "b") {
+		active_suffix = "_b";
+		inactive_suffix = "_a";
+	} else {
+		LOGERR("Unsupported active slot '%s' for /vendor_boot\n", slot.c_str());
+		return false;
+	}
+
+	const std::string& source = target_partition->Actual_Block_Device;
+	if (source.size() <= active_suffix.size() ||
+		source.compare(source.size() - active_suffix.size(), active_suffix.size(), active_suffix) != 0) {
+		LOGERR("Active vendor_boot block device '%s' does not match slot '%s'\n", source.c_str(), slot.c_str());
+		return false;
+	}
+
+	const std::string destination = source.substr(0, source.size() - active_suffix.size()) + inactive_suffix;
+	if (!TWFunc::Path_Exists(source) || !TWFunc::Path_Exists(destination)) {
+		LOGERR("Unable to access vendor_boot slot devices '%s' and '%s'\n", source.c_str(), destination.c_str());
+		return false;
+	}
+
+	const uint64_t destination_size = TWFunc::IOCTL_Get_Block_Size(destination.c_str());
+	if (destination_size == 0) {
+		LOGERR("Unable to determine inactive vendor_boot size\n");
+		return false;
+	}
+
+	const std::string workdir = "/tmp/fox-vendor-boot-reflash";
+	if (TWFunc::Path_Exists(workdir) && TWFunc::removeDir(workdir, false) != 0) {
+		LOGERR("Unable to clear the vendor_boot reflash work directory\n");
+		return false;
+	}
+	if (!TWFunc::Recursive_Mkdir(workdir))
+		return false;
+	ScopedRepackWorkdir cleanup(workdir);
+
+	const std::string source_dir = workdir + "/source";
+	const std::string inactive_dir = workdir + "/inactive";
+	const std::string verify_dir = workdir + "/verify";
+	if (!TWFunc::Recursive_Mkdir(source_dir) || !TWFunc::Recursive_Mkdir(inactive_dir) || !TWFunc::Recursive_Mkdir(verify_dir))
+		return false;
+
+	gui_print("Preparing the inactive vendor_boot recovery fragment...\n");
+	const std::string magiskboot = TWFunc::Get_MagiskBoot();
+	if (TWFunc::Exec_Cmd("cd " + ShellQuote(source_dir) + " && " + ShellQuote(magiskboot) +
+			" unpack --vendor -n -h " + ShellQuote(source), false) != 0)
+		return false;
+
+	const std::string source_recovery = source_dir + "/vendor_ramdisk_recovery.cpio";
+	if (!TWFunc::Path_Exists(source_recovery)) {
+		LOGERR("Active vendor_boot has no recovery ramdisk fragment\n");
+		return false;
+	}
+
+	const std::string inactive_image = inactive_dir + "/vendor_boot.img";
+	if (TWFunc::Exec_Cmd("dd bs=1048576 if=" + ShellQuote(destination) + " of=" + ShellQuote(inactive_image) + " conv=fsync", false) != 0 ||
+		TWFunc::Exec_Cmd("cd " + ShellQuote(inactive_dir) + " && " + ShellQuote(magiskboot) +
+			" unpack --vendor -n -h vendor_boot.img", false) != 0)
+		return false;
+
+	const std::string inactive_recovery = inactive_dir + "/vendor_ramdisk_recovery.cpio";
+	const std::string inactive_dtb = inactive_dir + "/dtb";
+	if (!TWFunc::Path_Exists(inactive_recovery) || !TWFunc::Path_Exists(inactive_dtb))
+		return false;
+
+	VendorBootAvbInfo inactive_avb;
+	bool direct_repack_fits = false;
+	if (!ReadVendorBootAvb(inactive_image, destination_size, &inactive_avb) ||
+		!CanDirectlyReplaceRecoveryFragment(inactive_avb, inactive_image, inactive_dir, inactive_recovery,
+			source_recovery, &direct_repack_fits)) {
+		LOGERR("Unable to calculate inactive vendor_boot capacity safely\n");
+		gui_print("Unable to validate inactive vendor_boot capacity; no partition was written.\n");
+		return false;
+	}
+
+	DataManager::SetProgress(.35);
+	const std::string rebuilt_image = workdir + "/new-vendor_boot.img";
+	std::string expected_dir = inactive_dir;
+	std::string expected_recovery = source_recovery;
+	std::string expected_dtb = inactive_dtb;
+	bool verify_uncompressed = false;
+	if (direct_repack_fits) {
+		if (TWFunc::copy_file(source_recovery, inactive_recovery, 0644, false) != 0 ||
+			TWFunc::Exec_Cmd("cd " + ShellQuote(inactive_dir) + " && " + ShellQuote(magiskboot) +
+				" repack -n vendor_boot.img " + ShellQuote(rebuilt_image), false) != 0)
+			return false;
+	} else {
+		// Safe trim: remove from the inactive platform only entries that are
+		// byte-identical in the slot's own official recovery fragment. This
+		// frees the space needed for the ramdisk-backed OrangeFox fragment
+		// while keeping normal-boot platform files (sepolicy, ueventd, init,
+		// fstab) intact.
+		gui_print("Trimming only inactive platform entries duplicated by the official Recovery fragment...\n");
+		const std::string trim_dir = workdir + "/trim";
+		const std::string source_recovery_raw = workdir + "/source-recovery.cpio";
+		if (!TWFunc::Recursive_Mkdir(trim_dir) ||
+			!MakeUncompressedCpio(magiskboot, source_recovery, source_recovery_raw) ||
+			TWFunc::Exec_Cmd("cd " + ShellQuote(trim_dir) + " && " + ShellQuote(magiskboot) +
+				" unpack --vendor -h " + ShellQuote(inactive_image), false) != 0)
+			return false;
+
+		const std::string trim_platform = trim_dir + "/vendor_ramdisk_.cpio";
+		const std::string trim_recovery_official = trim_dir + "/vendor_ramdisk_recovery.cpio";
+		const std::string trim_dtb = trim_dir + "/dtb";
+		if (!TWFunc::Path_Exists(trim_platform) || !TWFunc::Path_Exists(trim_recovery_official) || !TWFunc::Path_Exists(trim_dtb) ||
+			TWFunc::Exec_Cmd(ShellQuote("/system/bin/sh") + " " + ShellQuote("/system/bin/dali-safe-trim.sh") +
+				" " + ShellQuote(magiskboot) + " " + ShellQuote(trim_platform) + " " + ShellQuote(trim_recovery_official), false) != 0 ||
+			TWFunc::copy_file(source_recovery_raw, trim_recovery_official, 0644, false) != 0) {
+			LOGERR("Unable to safe-trim the inactive platform fragment\n");
+			gui_print("Unable to safe-trim the inactive platform fragment safely; no partition was written.\n");
+			return false;
+		}
+
+		const std::string repack_dir = trim_dir + "/gzip";
+		const std::string repack_platform = repack_dir + "/vendor_ramdisk_.cpio";
+		const std::string repack_recovery = repack_dir + "/vendor_ramdisk_recovery.cpio";
+		if (!TWFunc::Recursive_Mkdir(repack_dir) ||
+			TWFunc::copy_file(trim_platform, repack_platform, 0644, false) != 0 ||
+			TWFunc::copy_file(trim_recovery_official, repack_recovery, 0644, false) != 0 ||
